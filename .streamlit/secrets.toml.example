# Copy this file to .streamlit/secrets.toml and fill in your keys. Never commit secrets.toml.

# Required for the chat agent and for building the index: https://openrouter.ai/keys
OPENROUTER_API_KEY = "your-openrouter-key"

# Optional: live family events. Free key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY = "your-ticketmaster-key"
